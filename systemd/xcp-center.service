[Unit]
Description=XCP Center Web
After=network.target

[Service]
Type=simple
User=xcpcenter
Group=xcpcenter
WorkingDirectory=/opt/xcp-center-web
ExecStart=/opt/xcp-center-web/venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8443
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
