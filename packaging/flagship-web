#!/bin/bash
set -euo pipefail
cd /opt/flagship-web
case ${1:-} in
  version) echo 'Flagship Web 1.0.0' ;;
  serve) exec /opt/flagship-web/venv/bin/gunicorn --workers 1 --threads 8 --timeout 120 --bind 127.0.0.1:8443 flagship_web.wsgi:app ;;
  *) echo 'Usage: flagship-web {version|serve}' >&2; exit 2 ;;
esac
